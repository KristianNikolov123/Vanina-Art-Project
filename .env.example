BASE_PATH=

SECRET_KEY=generate-a-random-string

# Where signup notifications are delivered (your Gmail is OK)
ADMIN_EMAIL=you@gmail.com

# cPanel email password for SMTP_USER / noreply (NOT Gmail App Password unless using Gmail SMTP)
ADMIN_EMAIL_PASSWORD=

MAIL_TRANSPORT=smtp
MAIL_FROM=noreply@vanina-art.com
SMTP_USER=noreply@vanina-art.com
SMTP_SERVER=mail.vanina-art.com
SMTP_PORT=465

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Сесия: изход след толкова минути БЕЗДЕЙСТВИЕ (240 = 4 часа). Реалната работа удължава сесията.
SESSION_IDLE_TIMEOUT_MINUTES=240

# 1 = показва PHP грешките в браузъра (само за локална разработка). На сървъра да е 0 или да липсва.
APP_DEBUG=0

# Данни за разписката и уведомленията (по желание)
SHOP_NAME=Ванина Арт
SHOP_ADDRESS=
SHOP_PHONE=

# SMS от сървъра (по желание, платен акаунт в smsapi.bg). Без тях бутонът SMS отваря SMS приложението.
SMS_PROVIDER=
SMS_API_TOKEN=
SMS_SENDER=
