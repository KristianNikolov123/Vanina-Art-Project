# Leave empty if served from document root, or set e.g. /Vanina-Art-Project for subdirectory
BASE_PATH=/Vanina-Art-Project

SECRET_KEY=your-secret-key-here
ADMIN_EMAIL=your-email@gmail.com
ADMIN_EMAIL_PASSWORD=your-app-password
SMTP_PORT=465

# Database: sqlite (default) or mysql
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vanina_art
DB_USER=root
DB_PASSWORD=
